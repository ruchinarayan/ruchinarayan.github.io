---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import EducationPreview from '../components/EducationPreview.astro';

const educations = (await getCollection('education')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout 
	title="Education | Ruchi Shankar" 
	description="About Ruchi Shankar Education"
>

	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Education"
				tagline="Academic background"
				align="start"
			/>
			<Grid variant="offset">
				{
					educations.map((education) => (
						<li>
							<EducationPreview education={education} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>



