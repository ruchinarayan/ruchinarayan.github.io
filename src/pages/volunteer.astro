---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import VolunteerPreview from '../components/VolunteerPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const volunteers = (await getCollection('volunteer')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="Volunteer | Ruchi Shankar"
	description="Learn about Ruchi Shankar's volunteer"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Volunteer"
				tagline="Volunteer as a Teaching Assistant"
				align="start"
			/>
			<Grid variant="offset">
				{
					volunteers.map((volunteer) => (
						<li>
							<VolunteerPreview volunteer={volunteer} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
